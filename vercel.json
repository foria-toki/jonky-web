{
  "cleanUrls": true,
  "redirects": [
    { "source": "/:path*", "has": [{ "type": "host", "value": "www.jonky.com.ar" }], "destination": "https://jonky.com.ar/:path*", "permanent": true }
  ],
  "headers": [
    { "source": "/(.*)\\.(woff2|webp|jpg|png|ico)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ]
}
